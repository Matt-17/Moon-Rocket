{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "moonrocket-game",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "reddit": true,
    "redis": true
  },
  "menu": {
    "items": [
      {
        "label": "Create Moon Rocket Game Post",
        "description": "Creates a new Moon Rocket game post",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Create Daily Recap Post",
        "description": "Posts yesterday's Moon Rocket results with a replayable archive",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/daily-post-create"
      }
    ]
  },
  "scheduler": {
    "tasks": {
      "daily-challenge": {
        "endpoint": "/internal/scheduler/daily-post",
        "cron": "15 0 * * *"
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "dev": {
    "subreddit": "moonrocket_game_dev"
  }
}